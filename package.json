{
  "name": "pet-asistente",
  "version": "1.0.0",
  "private": true,
  "main": "desktop/electron/main.js",
  "description": "Desktop pet assistant — Electron frontend + Python backend + Ollama AI",
  "author": {
    "name": "Said Avendaño",
    "email": "saidavendano@artistshot.com"
  },
  "scripts": {
    "install:all": "node scripts/install-all.js",
    "dev:backend": "node scripts/run-backend.js",
    "dev:desktop": "npm --prefix desktop run dev",
    "dev": "npm --prefix desktop run dev",
    "build:renderer": "npm --prefix desktop run build:renderer",
    "build:backend": "node scripts/build-backend.js",
    "build": "npm run build:renderer && npm run build:backend",
    "pack": "npm --prefix desktop run dist",
    "pack:win": "npm --prefix desktop run dist:win",
    "pack:linux": "npm --prefix desktop run dist:linux",
    "release": "npm run build && npm run pack",
    "start": "npm --prefix desktop run start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  }
}
