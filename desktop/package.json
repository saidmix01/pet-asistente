{
  "name": "pet-asistente",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop pet assistant with ClickUp integration",
  "author": "Said Avendaño <saidavendano@artistshot.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix renderer run dev\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "npm --prefix renderer run build",
    "postinstall": "node scripts/ensure-electron-path.js",
    "start": "electron .",
    "dist": "npm run build:renderer && electron-builder --win"
  },
  "build": {
    "appId": "com.saidavendano.pet-asistente",
    "productName": "Pet Asistente",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/dist/**/*",
      "chat-renderer/**/*",
      "config-renderer/**/*",
      "!renderer/src/**",
      "!renderer/node_modules/**",
      "!node_modules/.cache/**"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/asistente-core.exe",
        "to": "backend/asistente-core.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": null,
      "uninstallerIcon": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pet Asistente"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.10"
  }
}
