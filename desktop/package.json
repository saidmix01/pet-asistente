{
  "name": "pet-asistente",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop pet assistant with ClickUp integration",
  "homepage": "https://github.com/saidmix01/pet-asistente",
  "author": "Said Avendaño <saidavendano@artistshot.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix renderer run dev\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/launch-electron.js\"",
    "build:renderer": "npm --prefix renderer run build",
    "postinstall": "node scripts/ensure-electron-path.js",
    "start": "node scripts/launch-electron.js",
    "dist": "npm run build:renderer && electron-builder",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:linux": "npm run build:renderer && electron-builder --linux"
  },
  "build": {
    "appId": "com.saidavendano.pet-asistente",
    "productName": "Pet Asistente",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "scripts/set-x11-overlay.py",
      "renderer/dist/**/*",
      "chat-renderer/**/*",
      "config-renderer/**/*",
      "assets/**/*",
      "!renderer/src/**",
      "!renderer/node_modules/**",
      "!node_modules/.cache/**"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pet Asistente"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableArgs": [
        "--ozone-platform=x11",
        "--enable-transparent-visuals"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "Said Avendaño <saidavendano@artistshot.com>"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.10"
  }
}
